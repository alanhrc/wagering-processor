# Application runtime
TZ=UTC
PORT=3000

# PostgreSQL connection and local port binding
DB_POSTGRES_HOST=localhost
DB_POSTGRES_BIND_HOST=127.0.0.1
DB_POSTGRES_PORT=5436
DB_POSTGRES_NAME=wagering_db
DB_POSTGRES_USER=postgres
DB_POSTGRES_PASSWORD=postgres
DB_POSTGRES_SCHEMA=

# Keycloak server and bootstrap administrator
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

# OIDC token validation
OIDC_ISSUER=http://localhost:8080/realms/wagering
OIDC_AUDIENCE=wagering-api
OIDC_SWAGGER_CLIENT_ID=wagering-swagger

# Swagger login redirect and allowed origin
KEYCLOAK_SWAGGER_REDIRECT_URI=http://localhost:3000/docs/oauth2-redirect.html
KEYCLOAK_API_ORIGIN=http://localhost:3000

# Initial user provisioning in Keycloak
AUTH_SEED_EMAIL=
AUTH_SEED_PASSWORD=

# Keycloak service account for load testing
KEYCLOAK_LOAD_CLIENT_SECRET=

# LocalStack services
LOCALSTACK_PORT=4566
LOCALSTACK_SERVICES=sqs
LOCALSTACK_AUTH_TOKEN=

# AWS SDK region and credentials
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# SQS endpoint and FIFO queues
AWS_SQS_ENDPOINT=http://localhost:4566
AWS_SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
AWS_SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo
AWS_SQS_DLQ_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo

# Test data retention
KEEP_TEST_SCHEMA=false

# Local load test configuration
LOAD_TEST_CONFIRM_LOCAL=YES
LOAD_TEST_REQUESTS=500
LOAD_TEST_CONCURRENCY=25
LOAD_TEST_WARMUP_REQUESTS=10
LOAD_TEST_REPORT_PATH=
