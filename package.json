{
  "name": "wagering-processor",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:debug": "bun --inspect --watch src/main.ts",
    "start:prod": "bun dist/src/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "bun test ./src ./test/swagger.spec.ts",
    "test:watch": "bun test --watch ./src ./test/swagger.spec.ts",
    "test:cov": "bun test --coverage ./src ./test/swagger.spec.ts",
    "test:debug": "bun --inspect test ./src ./test/swagger.spec.ts",
    "test:e2e": "bun test ./test/*.e2e.test.ts",
    "test:integration": "bun test --timeout 30000 ./test/integration/",
    "test:load": "bun scripts/load-test.ts",
    "seed:user": "bun scripts/seed-user.ts",
    "migration:up": "bun --bun mikro-orm migration:up",
    "migration:create": "bun --bun mikro-orm migration:create",
    "test:all": "bun run test && bun run test:e2e && bun run test:integration"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1169.0",
    "@mikro-orm/core": "^7.2.9",
    "@mikro-orm/decorators": "^7.2.9",
    "@mikro-orm/migrations": "^7.2.9",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.9",
    "@mikro-orm/reflection": "^7.2.9",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.2",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.9",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "bun-types": "^1.4.4",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2"
  }
}
